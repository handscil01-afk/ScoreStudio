        <lyric number="2"><syllabic>single</syllabic><text>나</text></lyric></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type>
        <lyric number="1"><syllabic>single</syllabic><text>님</text></lyric>
