      <note><pitch><step>C</step><octave>5</octave></pitch><duration>6</duration><voice>2</voice><type>half</type><dot/></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>2</duration><voice>2</voice><type>quarter</type></note>
