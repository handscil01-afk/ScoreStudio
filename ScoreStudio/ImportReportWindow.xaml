<Window x:Class="ScoreStudio.ImportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicXML 가져오기 결과" Width="680" Height="520" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="FileText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SummaryText" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <Border Background="#FFF6E5" BorderBrush="#E8C88A" BorderThickness="1" Padding="10" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="#5C4210"
                           Text="음표, 쉼표, 조표, 빔(음표 잇기), 음자리표 변경, 옥타브 기호(8va 등)는 악보 화면에 표시되고, 숨긴 보표와 원본의 줄·페이지 나눔도 따릅니다. 가사, 코드 이름, 붙임줄, 도돌이표·볼타는 저장되지만 아직 화면에 표시되지 않습니다(다음 단계에서 구현). 원본 파일은 바뀌지 않았습니다. 결과를 보관하려면 '저장'으로 .scoreproj 파일을 만드세요."/>
            </Border>
            <TextBlock x:Name="WarningHeader" FontWeight="SemiBold" Margin="0,14,0,6"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="경고 목록 복사" Padding="12,4" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="확인" Padding="20,4" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>

        <ListView x:Name="WarningList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="가져오지 않았거나 바뀐 내용" Width="360" DisplayMemberBinding="{Binding Message}"/>
                    <GridViewColumn Header="개수" Width="60" DisplayMemberBinding="{Binding Count}"/>
                    <GridViewColumn Header="처음 위치" Width="180" DisplayMemberBinding="{Binding FirstLocation}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
