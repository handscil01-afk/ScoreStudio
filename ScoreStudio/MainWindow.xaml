<Window x:Class="ScoreStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:ScoreStudio.Rendering"
        Title="ScoreStudio" Height="820" Width="1280"
        MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <DockPanel>
        <!-- Finale's menu bar: File, Edit, Utilities, View, Document, Tools, the chosen tool's menu, Plug-ins, Help. -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새 악보" Click="NewScore_Click"/>
                <MenuItem Header="열기..." Click="OpenProject_Click"/>
                <MenuItem Header="저장..." Click="SaveProject_Click"/>
                <Separator/>
                <MenuItem Header="가져오기">
                    <MenuItem Header="MusicXML..." Click="ImportMusicXml_Click"/>
                    <MenuItem Header="PDF·그림에서 악보 인식..." Click="RecognizeScore_Click"
                              ToolTip="스캔한 PDF나 캡처한 악보 그림을 Audiveris로 읽어 악보로 바꿉니다. 여러 개를 고르면 이름 순서대로 이어 붙입니다."/>
                    <MenuItem Header="Finale 파일(.musx)..." IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="아직 지원하지 않습니다."/>
                </MenuItem>
                <MenuItem Header="내보내기">
                    <MenuItem Header="PDF..." IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="다음 개발 단계에서 구현합니다."/>
                    <MenuItem Header="MusicXML..." IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="아직 지원하지 않습니다."/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="끝내기" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem x:Name="UndoMenuItem" Header="실행 취소" Tag="Undo" Click="Command_Click"/>
                <MenuItem x:Name="RedoMenuItem" Header="다시 실행" Tag="Redo" Click="Command_Click"/>
                <Separator/>
                <MenuItem Header="마디 복사" Tag="CopyMeasure" Click="Command_Click"/>
                <MenuItem x:Name="PasteMenuItem" Header="마디 붙여넣기" Tag="PasteMeasure" Click="Command_Click"/>
                <MenuItem Header="지우기(쉼표로)" Tag="Delete" Click="Command_Click"/>
                <Separator/>
                <MenuItem Header="단축키 설정..." Click="KeySettings_Click"/>
                <MenuItem Header="환경 설정">
                    <MenuItem x:Name="TieAcrossBarlinesMenuItem" Header="마디를 넘는 음표를 다음 마디로 이어 넣기(붙임줄)" IsCheckable="True"
                              Click="TieAcrossBarlines_Click"
                              ToolTip="끄면(기본) 마디에 남은 길이보다 긴 음표는 넣지 않습니다. 켜면 남은 만큼 넣고 나머지를 다음 마디에 붙임줄로 이어 넣습니다."/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="유틸리티(_U)">
                <MenuItem Header="반음 올리기" Tag="SemitoneUp" Click="Command_Click"/>
                <MenuItem Header="반음 내리기" Tag="SemitoneDown" Click="Command_Click"/>
                <MenuItem Header="한 칸 올리기" Tag="StepUp" Click="Command_Click"/>
                <MenuItem Header="한 칸 내리기" Tag="StepDown" Click="Command_Click"/>
                <MenuItem Header="옥타브 올리기" Tag="OctaveUp" Click="Command_Click"/>
                <MenuItem Header="옥타브 내리기" Tag="OctaveDown" Click="Command_Click"/>
                <MenuItem Header="딴이름한소리(엔하모닉)" Tag="Respell" Click="Command_Click"/>
                <Separator/>
                <MenuItem Header="다음 음과 붙임줄" Tag="TieToNext" Click="Command_Click"/>
                <MenuItem Header="기둥 방향 뒤집기" Tag="FlipStem" Click="Command_Click"/>
                <MenuItem Header="기둥 방향 자동" Tag="AutoStem" Click="Command_Click"/>
                <MenuItem Header="빔 다시 묶기" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="아직 지원하지 않습니다."/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="확대" InputGestureText="Ctrl+=" Click="ZoomIn_Click"/>
                <MenuItem Header="축소" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <MenuItem Header="100%로 보기" InputGestureText="Ctrl+0" Click="ZoomReset_Click"/>
            </MenuItem>
            <MenuItem Header="문서(_D)">
                <MenuItem x:Name="KeyMenu" Header="조표 바꾸기 (입력 위치의 마디부터)"/>
                <MenuItem x:Name="TimeMenu" Header="박자표 바꾸기 (입력 위치의 마디부터)"/>
                <MenuItem x:Name="ClefMenu" Header="음자리표 바꾸기 (선택한 음표나 입력 위치에)"/>
                <Separator/>
                <MenuItem Header="입력 위치 뒤에 마디 추가" Click="InsertMeasure_Click"/>
                <MenuItem Header="입력 위치의 마디 삭제" Click="DeleteMeasure_Click"/>
            </MenuItem>
            <MenuItem x:Name="ToolMenu" Header="도구(_T)"/>
            <MenuItem x:Name="ToolCommandsMenu" Header="Speedy(_S)"/>
            <MenuItem Header="플러그인" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="아직 지원하지 않습니다."/>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="단축키 목록" Click="KeyHelp_Click"/>
                <MenuItem Header="개발 상태" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="새 악보" Click="NewScore_Click" Padding="10,4"/>
                <Button Content="열기" Click="OpenProject_Click" Padding="10,4"/>
                <Button Content="저장" Click="SaveProject_Click" Padding="10,4"/>
                <Button Content="가져오기" Click="ImportMusicXml_Click" Padding="10,4" ToolTip="MusicXML(.musicxml, .xml, .mxl) 가져오기"/>
                <Button Content="악보 인식" Click="RecognizeScore_Click" Padding="10,4" ToolTip="PDF·그림(스캔, 화면 캡처)의 악보를 읽어 옵니다 (Audiveris 사용)"/>
                <Separator/>
                <Button Content="−" Click="ZoomOut_Click" Padding="10,4" ToolTip="축소 (Ctrl+-)"/>
                <ComboBox x:Name="ZoomInput" Width="80" SelectionChanged="ZoomInput_SelectionChanged" ToolTip="배율 (Ctrl+0: 100%)">
                    <ComboBoxItem Content="50%" Tag="0.5"/>
                    <ComboBoxItem Content="75%" Tag="0.75"/>
                    <ComboBoxItem Content="100%" Tag="1"/>
                    <ComboBoxItem Content="125%" Tag="1.25"/>
                    <ComboBoxItem Content="150%" Tag="1.5"/>
                    <ComboBoxItem Content="200%" Tag="2"/>
                    <ComboBoxItem Content="300%" Tag="3"/>
                </ComboBox>
                <Button Content="+" Click="ZoomIn_Click" Padding="10,4" ToolTip="확대 (Ctrl+=)"/>
            </ToolBar>
            <ToolBar x:Name="InputToolBar">
                <TextBlock Text="입력 길이" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ToggleButton Tag="Whole" Click="Duration_Click" Focusable="False" Padding="3,1" ToolTip="온음표 (7)">
                    <r:MusicGlyphIcon Glyph="&#xE1D2;" Baseline="0.5" Fallback="온"/>
                </ToggleButton>
                <ToggleButton Tag="Half" Click="Duration_Click" Focusable="False" Padding="3,1" ToolTip="2분음표 (6)">
                    <r:MusicGlyphIcon Glyph="&#xE1D3;" Fallback="2분"/>
                </ToggleButton>
                <ToggleButton Tag="Quarter" Click="Duration_Click" Focusable="False" Padding="3,1" ToolTip="4분음표 (5)">
                    <r:MusicGlyphIcon Glyph="&#xE1D5;" Fallback="4분"/>
                </ToggleButton>
                <ToggleButton Tag="Eighth" Click="Duration_Click" Focusable="False" Padding="3,1" ToolTip="8분음표 (4)">
                    <r:MusicGlyphIcon Glyph="&#xE1D7;" Fallback="8분"/>
                </ToggleButton>
                <ToggleButton Tag="Sixteenth" Click="Duration_Click" Focusable="False" Padding="3,1" ToolTip="16분음표 (3)">
                    <r:MusicGlyphIcon Glyph="&#xE1D9;" Fallback="16분"/>
                </ToggleButton>
                <ToggleButton Tag="ThirtySecond" Click="Duration_Click" Focusable="False" Padding="3,1" ToolTip="32분음표 (2)">
                    <r:MusicGlyphIcon Glyph="&#xE1DB;" Fallback="32분"/>
                </ToggleButton>
                <ToggleButton x:Name="DotButton" Click="Dot_Click" Focusable="False" Padding="3,1" ToolTip="점 붙이기·떼기 (.)">
                    <r:MusicGlyphIcon Glyph="&#xE1E7;" Width="12" Baseline="0.5" GlyphSize="44" Fallback="점"/>
                </ToggleButton>
                <Button Click="Rest_Click" Focusable="False" Padding="3,1" ToolTip="입력 위치에 쉼표 넣기 (0)">
                    <r:MusicGlyphIcon Glyph="&#xE4E5;" Baseline="0.5" Fallback="쉼표"/>
                </Button>
                <Button Tag="SemitoneUp" Click="Command_Click" Focusable="False" Padding="3,1" ToolTip="선택한 음 반음 올림">
                    <r:MusicGlyphIcon Glyph="&#xE262;" Baseline="0.5" Fallback="♯"/>
                </Button>
                <Button Tag="SemitoneDown" Click="Command_Click" Focusable="False" Padding="3,1" ToolTip="선택한 음 반음 내림">
                    <r:MusicGlyphIcon Glyph="&#xE260;" Baseline="0.6" Fallback="♭"/>
                </Button>
                <Button Tag="TieToNext" Click="Command_Click" Content="붙임줄" Focusable="False" Padding="6,4" ToolTip="선택한 음을 다음 같은 음과 붙임줄로 잇기·풀기"/>
                <ToggleButton x:Name="TupletButton" Content="셋잇단 (Ctrl+3)" Click="Tuplet_Click" Focusable="False" Padding="6,4"
                              ToolTip="다음에 넣는 음표부터 셋잇단음표로 넣습니다(입력 길이 2개 시간에 3개). 다른 잇단음표는 Ctrl+2~7, Ctrl+9. 다시 누르거나 Esc로 취소합니다."/>
                <TextBlock x:Name="InputValueText" Text="4분음표" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0"/>
                <Separator/>
                <ToggleButton x:Name="MouseEntryButton" Content="마우스 입력 (N)" Click="MouseEntry_Click" Focusable="False" Padding="8,4"
                              ToolTip="Simple Entry 도구에서 오선 위를 눌러 그 높이의 음표를 넣습니다. Shift를 누른 채 누르면 그 자리의 화음에 더합니다. 끄면 누른 음표를 선택합니다."/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem x:Name="StatusText" Content="준비됨"/>
            <Separator/>
            <StatusBarItem x:Name="ScoreInfoText"/>
            <Separator/>
            <StatusBarItem Content=".scoreproj"/>
        </StatusBar>

        <!-- Finale's main tool palette: the chosen tool decides what a click and the keys do. -->
        <ToolBarTray DockPanel.Dock="Left" Orientation="Vertical">
            <ToolBar x:Name="ToolPalette"/>
        </ToolBarTray>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#D8DDE3" BorderThickness="0,0,1,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="악보 구성" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="제목" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SidebarTitle" Text="새 악보" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="파트" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SidebarParts" Text="파트 1" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="가져오기 상태" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ImportStatusText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#805A20"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="ScoreScroll" Grid.Column="1" Background="#E8EBEF" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScoreScroll_PreviewMouseWheel"
                          Focusable="True" FocusVisualStyle="{x:Null}" PreviewMouseLeftButtonDown="Score_MouseLeftButtonDown"
                          PreviewMouseMove="Score_MouseMove" MouseLeave="Score_MouseLeave">
                <StackPanel x:Name="PagesPanel" HorizontalAlignment="Center" Margin="28">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                    </StackPanel.LayoutTransform>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#D8DDE3" BorderThickness="1,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="속성" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="문서 제목"/>
                    <TextBox x:Name="TitleInput" Text="새 악보" Margin="0,4,0,12" TextChanged="TitleInput_TextChanged"/>
                    <TextBlock Text="페이지 크기"/>
                    <ComboBox x:Name="PageSizeInput" SelectedIndex="0" Margin="0,4,0,12" SelectionChanged="PageSizeInput_SelectionChanged">
                        <ComboBoxItem Content="A4 세로" Tag="A4|Portrait"/>
                        <ComboBoxItem Content="A4 가로" Tag="A4|Landscape"/>
                        <ComboBoxItem Content="Letter 세로" Tag="Letter|Portrait"/>
                        <ComboBoxItem Content="Letter 가로" Tag="Letter|Landscape"/>
                    </ComboBox>
                    <TextBlock Text="가사 (Ctrl+L)" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,4">
                        <TextBlock Text="절" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="VerseInput" Width="60" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                        </ComboBox>
                    </DockPanel>
                    <TextBox x:Name="LyricInput" Margin="0,0,0,8" TextChanged="LyricInput_TextChanged" PreviewKeyDown="LyricInput_PreviewKeyDown"
                             GotKeyboardFocus="TextInput_GotKeyboardFocus"
                             ToolTip="음표를 고르고 음절을 칩니다. 공백: 다음 음표로, -: 하이픈을 붙이고 다음 음표로, _: 연장선. Enter: 남은 글자 넣기. 빈 칸에서 Delete: 그 음표의 가사 지우기, Esc: 악보로 돌아가기."/>
                    <TextBlock Text="코드 이름 (Ctrl+K)" FontWeight="SemiBold"/>
                    <TextBox x:Name="ChordInput" Margin="0,4,0,12" TextChanged="ChordInput_TextChanged" PreviewKeyDown="ChordInput_PreviewKeyDown"
                             GotKeyboardFocus="TextInput_GotKeyboardFocus"
                             ToolTip="예: C, Am7, F#m7b5, Bbmaj7/D. 공백이나 Enter: 넣고 다음 음표로. 빈 칸에서 Delete: 그 자리의 코드 이름 지우기, Esc: 악보로 돌아가기."/>
                    <TextBlock Text="개발 메모" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#697586" Margin="0,4,0,0"
                               Text="악보 화면은 오선, 음자리표, 조표, 박자표, 마디선, 음표, 쉼표, 빔(음표 잇기), 붙임줄, 잇단음표, 가사, 코드 이름, 도돌이표·볼타, 음자리표 변경, 옥타브 기호를 표시합니다. 키보드와 마우스(마우스 입력, N)로 음표·쉼표를 입력하고 고칠 수 있습니다(편집 > 키보드 입력 방법). 셈여림, 이음줄, 아티큘레이션, 글자 지시는 아직 가져오지도 표시하지도 않습니다. 편집 메뉴에서 조표·박자표·음자리표를 바꿀 수 있고, Ctrl+3(셋잇단)처럼 잇단음표를 넣을 수 있습니다. 가사(Ctrl+L)와 코드 이름(Ctrl+K)은 이 칸 위의 입력 칸에서 넣습니다. MUSX 변환, PDF 출력은 아직 지원하지 않습니다."/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
