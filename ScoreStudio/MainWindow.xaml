<Window x:Class="ScoreStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScoreStudio" Height="820" Width="1280"
        MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_파일">
                <MenuItem Header="새 악보" Click="NewScore_Click"/>
                <MenuItem Header="프로젝트 열기..." Click="OpenProject_Click"/>
                <MenuItem Header="프로젝트 저장..." Click="SaveProject_Click"/>
                <Separator/>
                <MenuItem Header="MusicXML 가져오기..." IsEnabled="False" ToolTip="다음 개발 단계에서 구현합니다."/>
                <MenuItem Header="PDF 내보내기..." IsEnabled="False" ToolTip="다음 개발 단계에서 구현합니다."/>
            </MenuItem>
            <MenuItem Header="_편집">
                <MenuItem Header="실행 취소" IsEnabled="False"/>
                <MenuItem Header="다시 실행" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_도움말">
                <MenuItem Header="개발 상태" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="새 악보" Click="NewScore_Click" Padding="10,4"/>
                <Button Content="열기" Click="OpenProject_Click" Padding="10,4"/>
                <Button Content="저장" Click="SaveProject_Click" Padding="10,4"/>
                <Separator/>
                <TextBlock Text="음표 입력 도구는 다음 단계에서 추가됩니다." VerticalAlignment="Center" Margin="8,0"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem x:Name="StatusText" Content="준비됨"/>
            <Separator/>
            <StatusBarItem Content=".scoreproj"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#D8DDE3" BorderThickness="0,0,1,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="악보 구성" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="제목" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SidebarTitle" Text="새 악보" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="파트" FontWeight="SemiBold"/>
                    <TextBlock Text="기본 파트 1개" Margin="0,4,0,12"/>
                    <TextBlock Text="가져오기 상태" FontWeight="SemiBold"/>
                    <TextBlock Text="MusicXML / MUSX 미구현" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#805A20"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Background="#E8EBEF" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" Margin="28">
                    <Border Background="White" Width="650" MinHeight="850" Padding="52" BorderBrush="#CCD2D9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="ScoreTitle" Text="새 악보" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,36"/>
                            <Canvas x:Name="ScoreCanvas" Height="260" Background="White"/>
                            <TextBlock Text="현재 화면은 UI 뼈대입니다. 실제 음표 입력 및 레이아웃은 이후 단계에서 구현합니다."
                                       TextWrapping="Wrap" Foreground="#697586" FontSize="12" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#D8DDE3" BorderThickness="1,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="속성" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="문서 제목"/>
                    <TextBox x:Name="TitleInput" Text="새 악보" Margin="0,4,0,12" TextChanged="TitleInput_TextChanged"/>
                    <TextBlock Text="페이지 크기"/>
                    <ComboBox SelectedIndex="0" Margin="0,4,0,12">
                        <ComboBoxItem Content="A4 세로"/>
                        <ComboBoxItem Content="A4 가로"/>
                        <ComboBoxItem Content="Letter"/>
                    </ComboBox>
                    <TextBlock Text="개발 메모" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#697586" Margin="0,4,0,0"
                               Text="먼저 프로젝트 저장/열기와 데이터 모델을 완성합니다. 아직 악보 편집기나 PDF 출력이 완성된 상태는 아닙니다."/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
