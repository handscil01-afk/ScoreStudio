<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScoreStudio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScoreStudio.Core\ScoreStudio.Core.csproj" />
  </ItemGroup>

  <!-- Bravura is read from the Fonts folder next to the executable (see docs/THIRD_PARTY.md). -->
  <ItemGroup>
    <Content Include="Fonts\Bravura.otf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fonts\Bravura-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship the sample projects so a downloaded build can be checked right away. -->
  <ItemGroup>
    <Content Include="..\samples\*.scoreproj" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
